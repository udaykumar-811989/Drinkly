# ============================================
# DRINKLY - Environment Variables
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/drinkly?schema=public"

# ============================================
# AUTHENTICATION
# ============================================
AUTH_SECRET="your-auth-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# PAYMENT PROVIDER (Stripe)
# ============================================
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# MAP PROVIDER (Google Maps)
# ============================================
MAP_PROVIDER="google-maps"
GOOGLE_MAPS_API_KEY="AIza..."

# ============================================
# STORAGE (AWS S3)
# ============================================
STORAGE_PROVIDER="s3"
STORAGE_ACCESS_KEY="AKIA..."
STORAGE_SECRET_KEY="..."
STORAGE_BUCKET="drinkly-documents"
STORAGE_REGION="us-east-1"

# ============================================
# SMS PROVIDER (Twilio)
# ============================================
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# ============================================
# EMAIL PROVIDER (Resend)
# ============================================
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@drinkly.com"

# ============================================
# PUSH NOTIFICATIONS (Firebase)
# ============================================
FIREBASE_PROJECT_ID="..."
FIREBASE_PRIVATE_KEY="..."
FIREBASE_CLIENT_EMAIL="..."

# ============================================
# VERIFICATION PROVIDER
# ============================================
VERIFICATION_PROVIDER="local"
VERIFICATION_API_KEY="..."

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME="Drinkly"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
