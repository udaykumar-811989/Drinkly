generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  RETAILER_OWNER
  RETAILER_STAFF
  DELIVERY_AGENT
  COMPLIANCE_OFFICER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  AGE_VERIFICATION_REQUIRED
  SUSPENDED
  BLOCKED
}

enum AgeVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  REVIEW_REQUIRED
  BLOCKED
}

enum RetailerStatus {
  PENDING
  DOCUMENT_REVIEW
  VERIFIED
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
}

enum RetailerStaffRole {
  MANAGER
  STAFF
}

enum DeliveryAgentStatus {
  PENDING
  VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  SUSPENDED
  PROHIBITED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  COMPLIANCE_CHECK
  RETAILER_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DELIVERY_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERY_VERIFICATION
  DELIVERED
  CANCELLED
  REJECTED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum ComplianceRuleType {
  MINIMUM_AGE
  DELIVERY_ENABLED
  DELIVERY_HOURS
  DRY_DAY
  RESTRICTED_LOCATION
  ALLOWED_LICENCE_TYPE
  ALLOWED_PRODUCT_CATEGORY
  MAX_ORDER_LIMIT
  DELIVERY_REQUIREMENT
  REQUIRED_VERIFICATION
}

enum ComplianceRuleStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum LicenceVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  REVIEW_REQUIRED
  BLOCKED
}

enum NotificationType {
  ORDER_UPDATE
  DELIVERY_UPDATE
  PAYMENT_UPDATE
  PROMOTION
  SYSTEM
  COMPLIANCE
  VERIFICATION
  SUPPORT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum OTPType {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
}

enum DryDayStatus {
  ACTIVE
  INACTIVE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  name            String
  role            UserRole  @default(CUSTOMER)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  twoFactorEnabled Boolean  @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  customerProfile  CustomerProfile?
  ownedRetailers   Retailer[]          @relation("RetailerOwner")
  staffMemberships RetailerStaff[]
  deliveryAgent    DeliveryAgent?
  addresses        Address[]
  cart             Cart?
  orders           Order[]             @relation("OrderCustomer")
  complianceRulesCreated ComplianceRule[] @relation("ComplianceCreatedBy")
  complianceRulesUpdated ComplianceRule[] @relation("ComplianceUpdatedBy")
  retailerLicencesVerified RetailerLicence[] @relation("RetailerLicenceVerifier")
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportTickets   SupportTicket[]     @relation("TicketUser")
  assignedTickets  SupportTicket[]     @relation("TicketAssignee")
  favorites        Favorite[]
  reviews          Review[]
  systemSettings   SystemSetting[]
  otps             OTP[]
  sessions         Session[]
  deliveryVerificationsPerformed DeliveryVerification[] @relation("VerifiedBy")
  deliveryVerificationsAsCustomer DeliveryVerification[] @relation("DeliveryVerificationCustomer")
  processedRefunds Refund[]            @relation("RefundProcessor")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([createdAt])

}

model CustomerProfile {
  id                    String                @id @default(uuid())
  userId                String                @unique
  dateOfBirth           DateTime
  ageVerified           AgeVerificationStatus @default(PENDING)
  verificationMethod    String?
  verificationReference String?

  addressLine1          String
  addressLine2          String?
  addressCity           String
  addressState          String
  addressZipCode        String
  addressCountry        String                @default("IN")
  addressLatitude       Float?
  addressLongitude      Float?
  addressIsDefault      Boolean               @default(true)

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ageVerified])

}

model Retailer {
  id                          String         @id @default(uuid())
  ownerId                     String
  legalBusinessName           String
  displayName                 String
  description                 String?
  phone                       String
  email                       String

  addressLine1                String
  addressLine2                String?
  addressCity                 String
  addressState                String
  addressZipCode              String
  addressCountry              String         @default("IN")
  latitude                    Float
  longitude                   Float

  logoUrl                     String?
  bannerUrl                   String?
  status                      RetailerStatus @default(PENDING)
  minimumOrderAmount          Decimal        @default(0)
  estimatedDeliveryTimeMinutes Int           @default(60)
  operatingRadiusKm           Decimal        @default(10)
  rating                      Decimal        @default(0)
  totalOrders                 Int            @default(0)

  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  deletedAt                   DateTime?

  owner        User               @relation("RetailerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  licences     RetailerLicence[]
  staff        RetailerStaff[]
  products     Product[]
  inventories  Inventory[]
  cartItems    CartItem[]
  orders       Order[]
  operatingHours OperatingHours[]
  reviews      Review[]

  @@index([ownerId])
  @@index([status])
  @@index([latitude, longitude])
  @@index([createdAt])

}

model RetailerLicence {
  id                 String                    @id @default(uuid())
  retailerId         String
  licenceNumber      String
  licenceType        String
  issuingAuthority   String
  issueDate          DateTime
  expiryDate         DateTime
  documentUrl        String
  verificationStatus LicenceVerificationStatus @default(PENDING)
  verifiedBy         String?
  verificationNotes  String?
  verifiedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  verifier User?    @relation("RetailerLicenceVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([retailerId])
  @@index([verificationStatus])
  @@index([licenceNumber])

}

model RetailerStaff {
  id         String            @id @default(uuid())
  retailerId String
  userId     String
  role       RetailerStaffRole @default(STAFF)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([retailerId, userId])
  @@index([retailerId])
  @@index([userId])

}

model DeliveryAgent {
  id              String              @id @default(uuid())
  userId          String              @unique
  dateOfBirth     DateTime
  vehicleType     String
  vehicleNumber   String
  licenseNumber   String

  addressLine1    String
  addressLine2    String?
  addressCity     String
  addressState    String
  addressZipCode  String
  addressCountry  String              @default("IN")
  latitude        Float
  longitude       Float

  isAvailable     Boolean             @default(false)
  currentOrderId  String?   @unique
  rating          Decimal             @default(0)
  totalDeliveries Int                 @default(0)
  status          DeliveryAgentStatus @default(PENDING)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  currentOrder Order?  @relation("CurrentDeliveryOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([latitude, longitude])
  @@index([isAvailable])

}

model Product {
  id              String        @id @default(uuid())
  retailerId      String
  categoryId      String
  name            String
  brand           String
  description     String?
  bottleSizeMl    Int
  alcoholPercentage Decimal
  mrp             Decimal
  sellingPrice    Decimal
  sku             String
  barcode         String?
  imageUrl        String?
  status          ProductStatus @default(ACTIVE)
  isAgeRestricted Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  retailer   Retailer     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]
  reviews    Review[]

  @@unique([retailerId, sku])
  @@index([retailerId])
  @@index([categoryId])
  @@index([status])
  @@index([brand])
  @@index([name])
  @@index([createdAt])

}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])

}

model Inventory {
  id                 String          @id @default(uuid())
  productId          String          @unique
  retailerId         String
  stockQuantity      Int             @default(0)
  reservedQuantity   Int             @default(0)
  lowStockThreshold  Int             @default(10)
  status             InventoryStatus @default(IN_STOCK)
  updatedAt          DateTime        @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([productId, retailerId])
  @@index([retailerId])
  @@index([status])

}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  zipCode   String
  country   String   @default("IN")
  latitude  Float
  longitude Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAddresses Order[] @relation("DeliveryAddress")

  @@index([userId])
  @@index([userId, isDefault])

}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])

}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  retailerId String
  quantity  Int      @default(1)
  unitPrice Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([retailerId])

}

model Order {
  id                    String      @id @default(uuid())
  orderNumber           String      @unique
  customerId            String
  retailerId            String
  deliveryAddressId     String
  status                OrderStatus @default(CREATED)

  subtotal              Decimal
  taxAmount             Decimal     @default(0)
  deliveryFee           Decimal     @default(0)
  platformFee           Decimal     @default(0)
  totalAmount           Decimal

  notes                 String?
  specialInstructions   String?
  estimatedDeliveryAt   DateTime?
  actualDeliveryAt      DateTime?
  cancelledAt           DateTime?
  cancelReason          String?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  customer        User                @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  retailer        Retailer            @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  deliveryAddress Address             @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  delivery         Delivery?
  currentDeliveryAgent DeliveryAgent? @relation("CurrentDeliveryOrder")
  deliveryVerifications DeliveryVerification[]
  reviews          Review[]

  @@index([customerId])
  @@index([retailerId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([customerId, status])

}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int      @default(1)
  unitPrice  Decimal
  totalPrice Decimal
  createdAt  DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])

}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String
  amount               Decimal
  currency             String        @default("INR")
  method               String
  providerTransactionId String?
  status               PaymentStatus @default(INITIATED)
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([providerTransactionId])

}

model Refund {
  id          String       @id @default(uuid())
  orderId     String
  paymentId   String
  amount      Decimal
  reason      String
  status      RefundStatus @default(PENDING)
  processedBy String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  processor User?   @relation("RefundProcessor", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])

}

model Delivery {
  id               String         @id @default(uuid())
  orderId          String         @unique
  agentId          String
  status           DeliveryStatus @default(ASSIGNED)
  pickupLatitude   Float
  pickupLongitude  Float
  currentLatitude  Float?
  currentLongitude Float?
  distanceKm       Decimal?
  estimatedMinutes Int?
  actualMinutes    Int?
  pickupAt         DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  agent        DeliveryAgent      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  verifications DeliveryVerification[]
  reviews      Review[]

  @@index([orderId])
  @@index([agentId])
  @@index([status])

}

model DeliveryVerification {
  id                String   @id @default(uuid())
  deliveryId        String
  orderId           String
  customerId        String
  verificationType  String
  idDocumentUrl     String?
  idDocumentType    String?
  isVerified        Boolean  @default(false)
  verifiedBy        String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime @default(now())

  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer  User     @relation("DeliveryVerificationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  verifier  User?    @relation("VerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([orderId])
  @@index([customerId])
  @@index([verifiedBy])

}

model ComplianceRule {
  id             String             @id @default(uuid())
  jurisdiction   String
  ruleType       ComplianceRuleType
  ruleValue      Json
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  status         ComplianceRuleStatus @default(ACTIVE)
  createdBy      String
  updatedBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  creator User @relation("ComplianceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User @relation("ComplianceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([jurisdiction])
  @@index([ruleType])
  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
  @@index([jurisdiction, ruleType, status])

}

model Jurisdiction {
  id                       String   @id @default(uuid())
  name                     String
  code                     String   @unique
  country                  String
  state                    String
  city                     String?
  isAlcoholDeliveryEnabled Boolean  @default(false)
  minimumAge               Int      @default(21)
  timezone                 String   @default("Asia/Kolkata")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  dryDays         DryDay[]
  operatingHours  OperatingHours[]

  @@index([code])
  @@index([country, state])

}

model DryDay {
  id            String       @id @default(uuid())
  jurisdictionId String
  date          DateTime
  reason        String?
  status        DryDayStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@unique([jurisdictionId, date])
  @@index([jurisdictionId])
  @@index([date])
  @@index([status])

}

model OperatingHours {
  id             String    @id @default(uuid())
  retailerId     String?
  jurisdictionId String?
  dayOfWeek      Int       @db.SmallInt
  openTime       String
  closeTime      String
  isClosed       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  retailer     Retailer?     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@unique([retailerId, dayOfWeek])
  @@unique([jurisdictionId, dayOfWeek])
  @@index([retailerId])
  @@index([jurisdictionId])
  @@index([dayOfWeek])

}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])

}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole String?
  action    String
  entityType String
  entityId   String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId, action])

}

model SupportTicket {
  id          String               @id @default(uuid())
  userId      String
  subject     String
  description String
  category    String
  status      SupportTicketStatus  @default(OPEN)
  priority    Int                  @default(0)
  assignedTo  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user       User  @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignee   User? @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assignedTo])
  @@index([status])
  @@index([category])
  @@index([createdAt])

}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])

}

model Review {
  id          String    @id @default(uuid())
  userId      String
  retailerId  String?
  productId   String?
  deliveryId  String?
  orderId     String?
  rating      Int       @db.SmallInt
  comment     String?
  isVerified  Boolean   @default(false)
  isModerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailer Retailer? @relation(fields: [retailerId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([retailerId])
  @@index([productId])
  @@index([deliveryId])
  @@index([orderId])
  @@index([rating])

}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updater User @relation(fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([key])

}

model OTP {
  id        String   @id @default(uuid())
  userId    String?
  phone     String?
  email     String?
  code      String
  type      OTPType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([email])
  @@index([code, type])
  @@index([expiresAt])

}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])

}
